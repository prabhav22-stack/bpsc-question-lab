# BPSC Question Lab - Streamlit Secrets Template
# Rename this file or copy to secrets.toml (in .streamlit/) for local development.
# In Streamlit Community Cloud, enter these key-value pairs in the App Settings > Secrets section.

# -------------------------------------------------------------
# Google Gemini API Configuration (Official google-genai SDK)
# -------------------------------------------------------------
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"
GEMINI_MODEL = "gemini-3.5-flash-lite"

# -------------------------------------------------------------
# Supabase Configuration (Optional - for cloud database & Auth)
# When not configured, the app operates smoothly in local SQLite mode.
# -------------------------------------------------------------
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-anon-public-key"
